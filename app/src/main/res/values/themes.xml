<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:statusBarColor">#F7F8FA</item>
        <item name="android:navigationBarColor">#E7E9EC</item>
        <item name="android:textColor">#2B3A4A</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AssistantTheme" parent="android:Theme.Translucent.NoTitleBar" />

    <style name="AppDialogTheme" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:textColor">#2B3A4A</item>
        <item name="android:textColorPrimary">#2B3A4A</item>
        <item name="android:textColorSecondary">#5B6672</item>
        <item name="android:colorAccent">#2B3A4A</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
    </style>

    <style name="AppDialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">#2B3A4A</item>
    </style>
</resources>
